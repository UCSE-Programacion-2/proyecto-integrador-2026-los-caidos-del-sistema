          "name": "DELETE - Eliminar item del carrito",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:4000/api/cart/items/:productId",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["api", "cart", "items", ":productId"],
              "variable": [
                {
                  "key": "productId",
                  "value": "REEMPLAZAR_CON_ID_REAL"
                }
              ]
            },
            "description": "Elimina un item del carrito por productId. Responde 200 o 404."
